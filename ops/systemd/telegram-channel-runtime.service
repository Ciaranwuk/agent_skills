[Service]
Type=simple
User=cwilson
Group=cwilson
WorkingDirectory=/home/cwilson/projects/agent_skills
Environment=PYTHONUNBUFFERED=1
Environment=CHANNEL_CODEX_ADD_DIRS=/mnt/d/agent_skills-offload,/mnt/d/crypto_fund_agents,/mnt/c/Users/ciara/OneDrive/Documents/llm_work_record
Environment=CHANNEL_WHISPER_MODEL_DIR=/mnt/d/agent_skills-offload/whisper-models
